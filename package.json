{
  "name": "billable",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,cyan\" \"npm run start:dev --workspace=api\" \"npm run dev --workspace=web\"",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "build": "npm run build:api && npm run build:web",
    "lint": "npm run lint --workspace=api && npm run lint --workspace=web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
